# ===========================================
# Production Environment Configuration
# Copy this to .env on your VPS and fill in real values
# ===========================================

# Domain (used by Caddy for automatic SSL)
DOMAIN=yourdomain.com

# Database
DB_USER=docplatform
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=docplatform

# Redis
REDIS_PASSWORD=CHANGE_ME_ANOTHER_STRONG_PASSWORD

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# Storage: "local" or "s3"
STORAGE_PROVIDER=local

# AWS S3 (only needed if STORAGE_PROVIDER=s3)
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# Frontend URL (used for CORS and email links)
FRONTEND_URL=https://yourdomain.com
